<Window x:Class="FIRSTMOD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FIRSTMOD - CEF Boost"
        Height="720" Width="1180"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ SOL SABİT MENÜ ============ -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="20,26,20,30">
                    <TextBlock Text="FIRSTMOD" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="CEF BOOST" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" Margin="1,3,0,0" />
                </StackPanel>

                <!-- Menü -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="BtnHome" Content="🏠   Ana Sayfa" Style="{StaticResource SidebarButtonStyle}" Tag="Active" Click="NavButton_Click" />
                    <Button x:Name="BtnCef" Content="⚙️   CEF İşlemleri" Style="{StaticResource SidebarButtonStyle}" Click="NavButton_Click" />
                    <Button x:Name="BtnGtaMta" Content="🎮   GTA / MTA" Style="{StaticResource SidebarButtonStyle}" Click="NavButton_Click" />
                    <Button x:Name="BtnSystem" Content="🖥️   Sistem" Style="{StaticResource SidebarButtonStyle}" Click="NavButton_Click" />
                    <Button x:Name="BtnSettings" Content="🛠️   Ayarlar" Style="{StaticResource SidebarButtonStyle}" Click="NavButton_Click" />
                </StackPanel>

                <!-- Alt bilgi -->
                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
                    <TextBlock Text="v1.0.0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ SAĞ İÇERİK ALANI ============ -->
        <Border Grid.Column="1" Background="{StaticResource BgDarkBrush}">
            <ContentControl x:Name="MainContent" Margin="0" />
        </Border>
    </Grid>
</Window>
